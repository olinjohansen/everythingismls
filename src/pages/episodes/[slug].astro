---
import Layout from '../../layouts/Layout.astro';
import PaperCard from '../../components/PaperCard.astro';
import { episodes } from '../../data/episodes.js';
import { getPaper } from '../../data/papers.js';

export function getStaticPaths() {
  return episodes.map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const referenced = (episode.papers || []).map(getPaper).filter(Boolean);
---

<Layout title={`${episode.title} — Everything is MLS`} description={episode.description}>
  <article class="section">
    <div class="container-x max-w-4xl">
      <!-- Header -->
      <div class="reveal">
        <div class="flex items-center gap-4 mb-5">
          <span class="font-mono text-5xl text-cyan leading-none">{episode.number}</span>
          <div class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-white/40 leading-relaxed">
            Episode<br />{episode.date}
          </div>
        </div>
        <h1 class="headline text-5xl md:text-7xl text-white leading-[0.95] mb-3">
          {episode.title}
        </h1>
        {episode.guest && (
          <p class="mono-label text-cyan">With {episode.guest}</p>
        )}
      </div>

      <!-- Player -->
      <div class="reveal mt-10 aspect-video w-full edge-card overflow-hidden">
        {
          episode.youtubeId ? (
            <iframe
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${episode.youtubeId}`}
              title={episode.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center gap-4 bg-ink-800">
              <span
                class="w-20 h-20 flex items-center justify-center border border-cyan/70 text-cyan text-2xl"
                style="box-shadow:0 0 40px rgba(0, 212, 212,0.25)"
              >
                ▶
              </span>
              <p class="mono-label text-white/40">Player coming soon</p>
            </div>
          )
        }
      </div>

      <!-- Platform links -->
      <div class="reveal mt-6 flex flex-wrap gap-3">
        <a href={episode.youtubeUrl} class="btn btn-primary !py-3 !px-5">▸ YouTube</a>
        <a href={episode.spotifyUrl} class="btn btn-ghost !py-3 !px-5">Spotify</a>
        <a href={episode.appleUrl} class="btn btn-ghost !py-3 !px-5">Apple</a>
      </div>

      <!-- Description -->
      <div class="reveal mt-12">
        <p class="eyebrow mb-5">About this episode</p>
        <p class="text-white/75 text-lg leading-relaxed max-w-prose2">{episode.description}</p>
      </div>

      <!-- Transcript (placeholder) -->
      <div class="reveal mt-14">
        <p class="eyebrow mb-5">Transcript</p>
        <div class="edge-card p-8">
          <p class="text-white/45 leading-relaxed">
            Full transcript coming soon — searchable across every episode.
          </p>
        </div>
      </div>

      <!-- Papers referenced -->
      <div class="reveal mt-14">
        <p class="eyebrow mb-5">Papers referenced</p>
        {
          referenced.length > 0 ? (
            <div class="grid md:grid-cols-2 gap-5 items-start">
              {referenced.map((p) => <PaperCard paper={p} />)}
            </div>
          ) : (
            <div class="edge-card p-8">
              <p class="text-white/45">Papers for this episode are being added.</p>
            </div>
          )
        }
      </div>

      <!-- Back -->
      <div class="reveal mt-16">
        <a href="/episodes" class="btn btn-ghost">← All episodes</a>
      </div>
    </div>
  </article>
</Layout>
