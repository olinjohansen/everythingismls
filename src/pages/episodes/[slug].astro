---
import Layout from '../../layouts/Layout.astro';
import { episodes } from '../../data/episodes.js';
import { listenLinks, chapterHref, episodeImage } from '../../data/episode-helpers.js';

export function getStaticPaths() {
  return episodes.map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const links = listenLinks(episode);
const chapters = episode.chapters || [];

// Show notes live in src/shownotes/<slug>.md. Globbed eagerly so the whole
// collection is available at build time, then matched to this episode.
const notesModules = import.meta.glob('../../shownotes/*.md', { eager: true });
const notes = Object.entries(notesModules).find(([path]) =>
  path.endsWith(`/${episode.slug}.md`)
)?.[1];
const Notes = notes?.Content;

// The section index is built from the chapter list plus the markdown's own H2s,
// so adding a section to the .md file adds it to the index automatically.
const noteSections = (notes?.getHeadings?.() ?? []).filter((h) => h.depth === 2);
const sections = [
  chapters.length && { slug: 'chapters', text: 'Chapters' },
  ...noteSections,
  { slug: 'transcript', text: 'Transcript' },
].filter(Boolean);
---

<Layout
  title={`${episode.number} · ${episode.title} — Everything is MLS`}
  description={episode.description}
  image={episodeImage(episode)}
>
  <article class="section">
    <div class="container-x max-w-4xl">
      <!-- Header -->
      <div class="reveal">
        <div class="flex items-center gap-4 mb-5">
          <span class="font-mono text-5xl text-cyan leading-none">{episode.number}</span>
          <div
            class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-white/40 leading-relaxed"
          >
            {episode.season && <>Season {episode.season} · </>}Episode<br />{episode.date}{
              episode.duration && <> · {episode.duration}</>
            }
          </div>
        </div>
        <h1 class="headline text-4xl md:text-6xl text-white leading-[0.95] mb-4">
          {episode.title}
        </h1>
        {episode.guest && <p class="mono-label text-cyan">With {episode.guest}</p>}
      </div>

      <!-- Player -->
      <div class="reveal mt-10 aspect-video w-full edge-card overflow-hidden">
        {
          episode.youtubeId ? (
            <iframe
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${episode.youtubeId}`}
              title={episode.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center gap-4 bg-ink-800">
              <span
                class="w-20 h-20 flex items-center justify-center border border-cyan/70 text-cyan text-2xl"
                style="box-shadow:0 0 40px rgba(0, 212, 212,0.25)"
              >
                ▶
              </span>
              <p class="mono-label text-white/40">Player coming soon</p>
            </div>
          )
        }
      </div>

      <!-- Platform links -->
      <div class="reveal mt-6 flex flex-wrap gap-3">
        {
          links.map((l, i) => (
            <a href={l.href} class={`btn !py-3 !px-5 ${i === 0 ? 'btn-primary' : 'btn-ghost'}`}>
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- Intro -->
      <div class="reveal mt-12">
        <p class="text-white/75 text-lg leading-relaxed max-w-prose2">{episode.description}</p>
      </div>

      <!-- Section index -->
      <nav class="reveal mt-10 pt-6 border-t border-white/[0.08]">
        <p class="mono-label text-white/30 !text-[0.58rem] mb-4">Jump to</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          {
            sections.map((s) => (
              <a
                href={`#${s.slug}`}
                class="mono-label text-white/45 hover:text-cyan transition-colors !text-[0.62rem]"
              >
                {s.text}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Chapters. Timestamps deep-link into YouTube once youtubeId is set. -->
      {
        chapters.length > 0 && (
          <section id="chapters" class="reveal mt-14 scroll-mt-28">
            <p class="eyebrow mb-5">Chapters</p>
            <ol class="edge-card divide-y divide-white/[0.08]">
              {chapters.map((c) => {
                const href = chapterHref(episode, c.time);
                const body = (
                  <div class="flex gap-5 px-6 py-4 sm:px-7">
                    <span class="font-mono text-cyan text-sm shrink-0 pt-0.5 w-[4.5rem] tabular-nums">
                      {c.time}
                    </span>
                    <div>
                      <p class="text-white/90 leading-snug">{c.title}</p>
                      {c.note && (
                        <p class="text-white/50 text-[0.92rem] leading-relaxed mt-1.5">{c.note}</p>
                      )}
                    </div>
                  </div>
                );
                return (
                  <li>
                    {href ? (
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block hover:bg-white/[0.03] transition-colors"
                        title="Jump to this moment"
                      >
                        {body}
                      </a>
                    ) : (
                      body
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }

      <!-- Show notes: everything authored in src/shownotes/<slug>.md.
           Deliberately NOT .reveal — the block is many screens tall, and the
           reveal observer needs 12% of an element visible to fire, which can
           never happen here. It would stay at opacity 0 forever. -->
      {
        Notes && (
          <div class="shownotes mt-14">
            <Notes />
          </div>
        )
      }

      <!-- Transcript -->
      <section id="transcript" class="reveal mt-14 scroll-mt-28">
        <p class="eyebrow mb-5">Transcript</p>
        {
          episode.transcript ? (
            <div class="edge-card p-8 whitespace-pre-line text-white/70 leading-relaxed max-w-prose2">
              {episode.transcript}
            </div>
          ) : (
            <div class="edge-card p-8">
              <p class="text-white/45 leading-relaxed">Full transcript coming soon.</p>
            </div>
          )
        }
      </section>

      <!-- Back -->
      <div class="reveal mt-16">
        <a href="/" class="btn btn-ghost">← All episodes</a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* ── Show notes ──────────────────────────────────────────
     Styling for the markdown body in src/shownotes/*.md. Written against the
     rendered HTML, so new sections pick it up with no extra work. */

  .shownotes > * + * {
    margin-top: 1.25rem;
  }

  /* H2 opens a section and gets the cyan rule the rest of the site uses */
  .shownotes h2 {
    font-family: 'TeX Gyre Heros', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 0.95;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #fff;
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 7rem;
  }

  .shownotes h3 {
    font-family: 'TeX Gyre Heros', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.15rem;
    color: var(--cyan);
    margin-top: 3rem;
    scroll-margin-top: 7rem;
  }

  .shownotes p {
    color: rgba(232, 234, 235, 0.72);
    line-height: 1.7;
    max-width: 68ch;
  }

  /* The line under each reference-group heading: timestamps · speakers — gist */
  .shownotes h3 + p em:first-child {
    font-family: '"JetBrains Mono"', ui-monospace, monospace;
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: rgba(0, 212, 212, 0.75);
  }

  .shownotes a {
    color: var(--cyan);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 212, 212, 0.3);
    transition: border-color 0.2s ease;
  }
  .shownotes a:hover {
    border-bottom-color: var(--cyan);
  }

  .shownotes strong {
    color: #fff;
    font-weight: 500;
  }
  .shownotes em {
    color: rgba(232, 234, 235, 0.5);
  }

  /* Reference lists: each item is a citation, each nested item its annotation */
  .shownotes ul {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }
  .shownotes ul > li {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.25rem;
    color: rgba(232, 234, 235, 0.82);
    line-height: 1.6;
  }
  .shownotes ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 1px;
    background: rgba(0, 212, 212, 0.6);
  }
  .shownotes ul ul {
    margin-top: 0.6rem;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 1rem;
  }
  .shownotes ul ul > li {
    padding-left: 0;
    padding-bottom: 0;
    font-size: 0.94rem;
    color: rgba(232, 234, 235, 0.55);
  }
  .shownotes ul ul > li::before {
    display: none;
  }

  /* Tables scroll inside their own box rather than widening the page */
  .shownotes table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    background: #0e0e0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .shownotes th,
  .shownotes td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    vertical-align: top;
  }
  .shownotes th {
    font-family: '"JetBrains Mono"', ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--cyan);
    white-space: nowrap;
    border-bottom-color: rgba(0, 212, 212, 0.25);
  }
  .shownotes td {
    color: rgba(232, 234, 235, 0.72);
  }
  /* First column is the row label — key it like the metadata it is */
  .shownotes td:first-child {
    color: rgba(232, 234, 235, 0.95);
    white-space: nowrap;
  }
  .shownotes tbody tr:last-child td {
    border-bottom: none;
  }
  .shownotes tbody tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* The explanatory italic line that follows several tables */
  .shownotes table + p em {
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .shownotes th,
    .shownotes td {
      padding: 0.6rem 0.75rem;
    }
  }
</style>
