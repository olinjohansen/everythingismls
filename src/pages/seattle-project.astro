---
import Layout from '../layouts/Layout.astro';

// Six uniform square tiles — 3 cols desktop, 2 tablet, 1 mobile.
const tiles = [
  { name: 'Governance', sub: 'How groups make rules that work', img: '/images/seattle-governance.jpg' },
  { name: 'Cities as Ecosystems', sub: 'Seattle as a living laboratory', img: '/images/seattle-cities.jpg' },
  { name: 'Business', sub: 'Why some companies evolve and others don’t', img: '/images/seattle-business.jpg' },
  { name: 'Housing', sub: 'The politics of who gets to belong', img: '/images/seattle-housing.jpg' },
  { name: 'Sports', sub: 'Group cohesion at game speed', img: '/images/seattle-sports.jpg' },
  { name: 'Arts', sub: 'Culture as evolutionary signal', img: '/images/seattle-arts.jpg' },
];
---

<Layout title="The Seattle Project — Everything is MLS">
  <section class="section">
    <div class="container-x">
      <p class="eyebrow mb-6 reveal">The Seattle Project</p>
      <h1 class="headline text-6xl md:text-8xl text-white leading-none max-w-3xl mb-5 reveal">
        One city.<br /><span class="text-cyan-glow">Six domains.</span>
      </h1>
      <p class="text-white/60 text-lg max-w-xl leading-relaxed mb-12 reveal">
        The places we watch Multi-Level Selection play out — from city hall to
        game day.
      </p>

      <!-- Uniform square grid: 1 / 2 / 3 columns -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          tiles.map((t, i) => (
            <div class="relative aspect-square overflow-hidden border border-white/[0.08] reveal" style={`transition-delay:${0.05 * i}s`}>
              <div class="absolute inset-0 film-vignette">
                <img
                  src={t.img}
                  alt={t.name}
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <div
                  class="absolute inset-0"
                  style="background:linear-gradient(180deg, rgba(8,8,8,0.15) 0%, rgba(8,8,8,0.55) 45%, rgba(8,8,8,0.92) 100%)"
                />
              </div>
              <div class="absolute inset-0 p-6 flex flex-col justify-end z-10">
                <span class="mono-label text-cyan mb-2 !text-[0.6rem]">
                  0{i + 1} · Domain
                </span>
                <h2 class="headline text-3xl md:text-4xl text-white leading-none mb-2">
                  {t.name}
                </h2>
                <p class="text-white/70 text-sm leading-snug">{t.sub}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
