---
import Layout from '../layouts/Layout.astro';

const hosts = [
  {
    name: 'David Sloan Wilson',
    role: 'Evolutionary Biologist · Co-Host',
    initials: 'DSW',
    bio: 'Evolutionary biologist and co-host. His work extends evolutionary science beyond the individual to groups, cultures, and whole societies.',
    links: [
      { label: 'This View of Life', href: 'https://thisviewoflife.com' },
      { label: 'ProSocial World', href: 'https://www.prosocial.world' },
      { label: 'E.O. Wilson Biodiversity Foundation', href: 'https://eowilsonfoundation.org' },
    ],
  },
  {
    name: 'Andy',
    role: 'Co-Host',
    initials: 'A',
    bio: 'Co-host and marketing professor (Yale PhD), bringing the social-science side of the conversation. Fuller bio coming soon.',
    links: [],
  },
  {
    name: 'Olin',
    role: 'Co-Host',
    initials: 'O',
    bio: 'Co-host of the show. Fuller bio coming soon.',
    links: [],
  },
];
---

<Layout title="Hosts — Everything is MLS">
  <section class="section">
    <div class="container-x max-w-4xl">
      <p class="eyebrow mb-6 reveal">Who you’re listening to</p>
      <h1 class="headline text-6xl md:text-8xl text-white leading-none mb-14 reveal">
        Hosts
      </h1>

      <div class="space-y-6">
        {
          hosts.map((h) => (
            <article class="edge-card reveal flex flex-col sm:flex-row gap-6 p-7">
              <!-- Portrait placeholder -->
              <div
                class="shrink-0 w-full sm:w-44 aspect-square flex items-center justify-center"
                style="background:radial-gradient(120% 120% at 50% 0%, rgba(0,212,212,0.14) 0%, #0b0b0c 60%)"
              >
                <span class="headline text-5xl text-cyan">{h.initials}</span>
              </div>

              <div class="flex flex-col">
                <h2 class="headline text-3xl md:text-4xl text-white leading-none">{h.name}</h2>
                <p class="mono-label text-cyan mt-2 !text-[0.6rem]">{h.role}</p>
                <p class="text-white/70 leading-relaxed mt-4 max-w-prose2">{h.bio}</p>
                {h.links.length > 0 && (
                  <div class="flex flex-wrap gap-3 mt-5">
                    {h.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener"
                        class="btn btn-ghost !py-2.5 !px-4 !text-[0.62rem]"
                      >
                        {l.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
