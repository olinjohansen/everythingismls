---
// Newsletter signup (Substack embed). Rendered above the footer on every
// page via the base Layout. The iframe is forced transparent + borderless so
// it blends into the dark background; it's full-width on mobile, capped at
// 480px on larger screens, and centered.
---

<section class="relative z-10 bg-ink-900 py-16 md:py-20">
  <div class="container-x text-center">
    <h2 class="headline text-4xl md:text-5xl text-white mb-3">Stay in the loop</h2>
    <p class="text-sm mb-8" style="color:#888888">New episodes. Occasional papers.</p>

    <div class="flex justify-center">
      <iframe
        src="https://everythingismls.substack.com/embed"
        title="Subscribe to Everything is MLS on Substack"
        width="480"
        height="320"
        loading="lazy"
        frameborder="0"
        scrolling="no"
        allowtransparency="true"
        class="newsletter-embed"
        style="border:none; background:transparent; width:100%; max-width:480px; height:320px;"
      ></iframe>
    </div>
  </div>
</section>
