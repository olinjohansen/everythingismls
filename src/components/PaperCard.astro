---
// Paper card for the library. The data-search attribute powers the
// client-side filter on /library.
const { paper } = Astro.props;
const rel = paper.relatedEpisodes || [];
const search = `${paper.title} ${paper.authors} ${paper.tags.join(' ')} ${paper.summary}`.toLowerCase();
---

<article class="edge-card paper-card p-7 flex flex-col" data-search={search}>
  <div class="flex items-start justify-between gap-3 mb-4">
    <span class="font-mono text-cyan text-sm">{paper.year}</span>
    <span class="mono-label text-white/30 !text-[0.58rem] text-right">Added by {paper.addedBy}</span>
  </div>

  <h3 class="headline text-2xl text-white mb-1">{paper.title}</h3>
  <p class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-white/40 mb-4">
    {paper.authors}
  </p>
  <p class="text-white/70 text-[0.95rem] leading-relaxed mb-6">{paper.summary}</p>

  <div class="flex flex-wrap gap-2 mb-5">
    {
      paper.tags.map((t) => (
        <span class="mono-label text-cyan/80 border border-cyan/25 px-2.5 py-1 !text-[0.58rem]">
          {t}
        </span>
      ))
    }
  </div>

  {
    rel.length > 0 && (
      <div class="mt-auto pt-4 border-t border-white/[0.08] flex flex-col gap-1">
        {rel.map((e) => (
          <a
            href={`/episodes/${e.slug}`}
            class="mono-label text-white/45 hover:text-cyan transition-colors !text-[0.58rem]"
          >
            ↳ Referenced in Episode {e.number}
          </a>
        ))}
      </div>
    )
  }
</article>
