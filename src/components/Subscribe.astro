---
// Subscribe strip — wired to Netlify Forms (no third-party account needed).
// Submissions appear in the Netlify dashboard under "Forms → newsletter".
// The hidden form-name input + data-netlify attr are what register it.
---

<section class="relative section section-loose overflow-hidden" id="subscribe">
  <div class="absolute inset-0 z-0 film-vignette edge-soak">
    <img
      src="/images/subscribe.jpg"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover opacity-25"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(180deg, rgba(8,8,8,0.95) 0%, rgba(8,8,8,0.7) 50%, rgba(8,8,8,0.95) 100%)"
    >
    </div>
  </div>

  <div class="container-x relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <p class="eyebrow justify-center mb-7 reveal">The newsletter</p>
      <h2
        class="headline text-[clamp(2.5rem,7vw,5.5rem)] text-white leading-[0.95] reveal"
        style="transition-delay:0.05s"
      >
        New episodes. Occasional papers.<br /><span class="text-cyan-glow"
          >No nonsense.</span
        >
      </h2>
      <p
        class="text-white/65 text-lg mt-6 max-w-xl mx-auto reveal"
        style="transition-delay:0.1s"
      >
        The arguments that didn’t make the final cut. The papers behind every
        claim. Never more than you’d want.
      </p>

      <form
        name="newsletter"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/?subscribed=true"
        class="mt-10 flex flex-col sm:flex-row gap-3 max-w-lg mx-auto reveal"
        style="transition-delay:0.15s"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 bg-ink-800 border border-white/15 focus:border-cyan px-5 py-4 text-white placeholder:text-white/30 outline-none font-mono text-sm tracking-wide transition-colors"
        />
        <button type="submit" class="btn btn-primary justify-center !py-4 !px-7">
          I’m in
        </button>
      </form>

      <p class="mono-label text-white/25 !text-[0.55rem] mt-5 reveal" style="transition-delay:0.2s">
        No selling your data. Obviously.
      </p>
    </div>
  </div>
</section>
