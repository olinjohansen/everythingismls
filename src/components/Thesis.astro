---
// The thesis, stated cold. Full-bleed dark band between the hero and the
// latest episode. The E.O. Wilson quote — no buttons, no CTAs, just the
// argument framed by two thin cyan rules.
---

<section class="relative w-full bg-ink-900" id="thesis">
  <!-- top hairline -->
  <div
    class="h-px w-full"
    style="background:linear-gradient(to right, transparent, rgba(0, 212, 212,0.5) 50%, transparent);filter:drop-shadow(0 0 6px rgba(0,212,212,0.5))"
  >
  </div>

  <div class="container-x py-28 md:py-40">
    <div class="max-w-4xl mx-auto text-center reveal">
      <blockquote
        class="font-display text-white leading-[1.12] text-[clamp(1.75rem,4.4vw,3.5rem)]"
      >
        <span class="block">Selfishness beats altruism within groups.</span>
        <span class="block">Altruistic groups beat selfish groups.</span>
        <span class="block">Everything else is commentary.</span>
      </blockquote>

      <!-- Attribution: the only glow allowed in this section, and a faint one -->
      <p
        class="font-mono text-sm mt-12"
        style="color:#888888;text-shadow:0 0 12px rgba(0,212,212,0.3)"
      >
        — E.O. Wilson
      </p>

      <!-- Kept stark: override the global cyan-text glow off here -->
      <p
        class="font-mono text-[0.7rem] tracking-[0.18em] text-cyan mt-4"
        style="text-shadow:none"
      >
        The entire argument. In three sentences.
      </p>
    </div>
  </div>

  <!-- bottom hairline -->
  <div
    class="h-px w-full"
    style="background:linear-gradient(to right, transparent, rgba(0, 212, 212,0.5) 50%, transparent);filter:drop-shadow(0 0 6px rgba(0,212,212,0.5))"
  >
  </div>
</section>
