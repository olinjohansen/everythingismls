---
// Coming Up — horizontal scroll of upcoming guests. Portraits are styled
// monogram placeholders until photos arrive via the `guests` collection.
const guests = [
  {
    slug: 'sample-economist',
    name: 'Dr. Marisol Vance',
    title: 'Behavioral Economist',
    org: 'University of Washington',
    date: 'Jun 16',
    topic: 'Trust as infrastructure',
  },
  {
    slug: 'sample-historian',
    name: 'Theo Brandt',
    title: 'Urban Historian',
    org: 'Seattle Civic Lab',
    date: 'Jun 30',
    topic: 'How neighborhoods remember',
  },
  {
    slug: 'sample-theologian',
    name: 'Rev. Ada Okonkwo',
    title: 'Scholar of Religion',
    org: 'Union Theological',
    date: 'Jul 14',
    topic: 'Ritual as group glue',
  },
  {
    slug: 'sample-biologist',
    name: 'Dr. Liang Wu',
    title: 'Microbial Ecologist',
    org: 'Fred Hutch',
    date: 'Jul 28',
    topic: 'Cooperation in the petri dish',
  },
];

const accents = ['#00D4D4', '#8AE2E8', '#3BA8B0', '#A8ECEF'];
---

<section class="section section-tight" id="coming-up">
  <div class="container-x">
    <div
      class="flex items-end justify-between gap-6 mb-10 reveal"
    >
      <div class="max-w-2xl">
        <p class="eyebrow mb-6">Upcoming guests</p>
        <h2 class="headline text-5xl md:text-6xl text-white leading-none">
          Coming up.
        </h2>
        <p class="text-white/60 mt-5 leading-relaxed">
          Jonathan Haidt on cancel culture. Peter Turchin on why elites get
          culled. Krist Novoselic on music and democracy. Among others.
        </p>
      </div>
      <a href="/guests" class="btn btn-ghost shrink-0 hidden md:inline-flex">All guests →</a>
    </div>
  </div>

  <!-- Edge-bleeding horizontal scroll -->
  <div
    class="flex gap-5 overflow-x-auto pb-6 px-[max(1.25rem,calc((100vw-1240px)/2+3.5rem))] snap-x snap-mandatory scroll-smooth"
    style="scrollbar-width:thin"
  >
    {
      guests.map((g, i) => (
        <article
          class="edge-card snap-start shrink-0 w-[280px] reveal flex flex-col"
          style={`transition-delay:${0.06 * i}s`}
        >
          <!-- Monogram portrait placeholder -->
          <div
            class="relative h-[200px] flex items-center justify-center overflow-hidden"
            style={`background:radial-gradient(120% 120% at 50% 0%, ${accents[i]}22 0%, #0b0b0c 60%)`}
          >
            <span
              class="headline text-6xl"
              style={`color:${accents[i]}`}
            >
              {g.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}
            </span>
            <span class="absolute top-4 left-4 mono-label text-white/45 !text-[0.58rem]">
              {g.date}
            </span>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="headline text-2xl text-white leading-tight">{g.name}</h3>
            <p class="mono-label text-cyan mt-1 !text-[0.6rem]">{g.title}</p>
            <p class="text-white/40 text-xs mt-1">{g.org}</p>
            <div class="border-t border-white/10 mt-4 pt-4 mt-auto">
              <p class="mono-label text-white/30 !text-[0.55rem] mb-1">On the docket</p>
              <p class="text-white/75 text-sm leading-snug">{g.topic}</p>
            </div>
          </div>
        </article>
      ))
    }
    <!-- trailing spacer for clean edge -->
    <div class="shrink-0 w-2" aria-hidden="true"></div>
  </div>
</section>
