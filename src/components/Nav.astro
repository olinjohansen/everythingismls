---
// The site is two templates deep — front page and episode pages — so the nav
// is the wordmark plus where to listen. No menu, no mobile drawer.
import { platformLinks } from '../data/site.js';
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  data-at-top="true"
>
  <div class="container-x flex items-center justify-between gap-4 h-[72px]">
    <!-- Wordmark -->
    <a href="/" class="group flex items-center gap-3 shrink-0">
      <span class="block w-2 h-2 bg-cyan" style="box-shadow:var(--glow-line)"></span>
      <span class="headline text-lg sm:text-xl text-white leading-none tracking-headline">
        Everything is <span
          class="text-cyan"
          style="text-shadow:0 0 25px rgba(0,212,212,0.8), 0 0 50px rgba(0,212,212,0.3)"
          >MLS</span
        > <span class="hidden sm:inline">Podcast</span>
      </span>
    </a>

    <!-- Where to listen. Hidden on phones, where the wordmark plus three mono
         labels won't fit in the 72px bar — the hero and footer both carry them. -->
    <nav class="hidden sm:flex items-center gap-5 sm:gap-6">
      {
        platformLinks.map((l) => (
          <a
            href={l.href}
            class="font-mono uppercase tracking-[0.18em] text-[0.68rem] text-white/60 hover:text-cyan transition-colors duration-200 whitespace-nowrap"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Solidify nav background once scrolled off the top
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    const atTop = window.scrollY < 40;
    nav.dataset.atTop = String(atTop);
    if (atTop) {
      nav.classList.remove('bg-ink-900/85', 'backdrop-blur-md', 'border-b', 'border-white/10');
    } else {
      nav.classList.add('bg-ink-900/85', 'backdrop-blur-md', 'border-b', 'border-white/10');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
