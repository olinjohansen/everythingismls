---
// Compact brand header for the front page. Not a full-viewport hero any more —
// the episode list is the point of the page, so this establishes the show and
// then gets out of the way.
// Photo: brutalist overpass emerging through PNW fog — human structure rising
// out of nature. The thesis in a single frame.
import { site, platformLinks } from '../data/site.js';

const spotify = platformLinks.find((p) => p.key === 'spotify');
const youtube = platformLinks.find((p) => p.key === 'youtube');
---

<section class="relative flex items-end overflow-hidden min-h-[clamp(26rem,58svh,38rem)] pt-[72px]">
  <!-- Background photo -->
  <div class="absolute inset-0 z-0 film-vignette scanlines edge-soak">
    <img
      src="/images/hero.jpg"
      alt="A concrete overpass emerging through Pacific Northwest fog and forest"
      class="w-full h-full object-cover object-center scale-105"
      fetchpriority="high"
    />
    <!-- Layered dark overlays for legibility + mood. The bottom stop is fully
         opaque so the photo dissolves into the episode list below it. -->
    <div class="absolute inset-0 bg-ink-900/55"></div>
    <div
      class="absolute inset-0"
      style="background:linear-gradient(180deg, rgba(8,8,8,0.8) 0%, rgba(8,8,8,0.3) 32%, rgba(8,8,8,0.97) 100%)"
    >
    </div>
    <div
      class="absolute inset-0"
      style="background:radial-gradient(120% 90% at 50% 40%, rgba(0, 212, 212,0.12) 0%, rgba(8,8,8,0) 58%)"
    >
    </div>
  </div>

  <!-- container-x so the headline's left edge lines up with the episode list -->
  <div class="relative z-10 container-x pb-[clamp(2.5rem,6vw,4rem)]">
    <h1
      class="headline text-white leading-[0.88] animate-fade-up"
      style="animation-delay:0.08s"
    >
      <span class="block text-[clamp(2.75rem,10vw,8rem)]">Everything</span>
      <span class="block text-[clamp(2.75rem,10vw,8rem)] whitespace-nowrap">
        is <span class="text-cyan-glow">MLS.</span>
      </span>
    </h1>

    <p
      class="eyebrow font-display tracking-[0.06em] font-normal text-white mt-6 animate-fade-up"
      style="animation-delay:0.16s"
    >
      {site.tagline}
    </p>

    <div class="mt-8 flex flex-wrap gap-4 animate-fade-up" style="animation-delay:0.24s">
      <a href={spotify.href} class="btn btn-primary">▸ Listen on Spotify</a>
      <a href={youtube.href} class="btn btn-ghost">▸ Watch on YouTube</a>
    </div>
  </div>
</section>
