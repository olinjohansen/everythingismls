---
// Paper Library teaser. Featured cards show ONLY the plain-English summary —
// the jargon lives one click deeper. Placeholder data for the `papers` collection.
const paperCount = 47;

const featured = [
  {
    slug: 'ostrom-governing-commons',
    title: 'Governing the Commons',
    authors: 'Elinor Ostrom',
    year: 1990,
    summary:
      'People sharing a limited resource — a fishery, a forest, a budget — don’t always wreck it. Given the right rules, ordinary communities govern themselves better than markets or governments do.',
    tags: ['Governance', 'Cooperation'],
    addedBy: 'Andy',
  },
  {
    slug: 'wilson-sober-altruism',
    title: 'Unto Others',
    authors: 'Sober & Wilson',
    year: 1998,
    summary:
      'The book that put group selection back on the table. Real altruism exists, and natural selection can favor it — as long as it’s selection between groups, not just within them.',
    tags: ['Altruism', 'Group Selection'],
    addedBy: 'DSW',
  },
  {
    slug: 'major-transitions',
    title: 'The Major Transitions in Evolution',
    authors: 'Maynard Smith & Szathmáry',
    year: 1995,
    summary:
      'Every big leap in life’s history — genes into cells, cells into bodies, bodies into societies — is the same trick repeated: a crowd of competitors becomes a single cooperating unit.',
    tags: ['Transitions', 'Cooperation'],
    addedBy: 'Olin',
  },
];
---

<section class="section" id="library-teaser">
  <div class="container-x">
    <div
      class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-12"
    >
      <div class="reveal">
        <p class="eyebrow mb-6">The Stack</p>
        <h2 class="headline text-5xl md:text-7xl text-white leading-none">
          Every claim we make,<br />
          <span class="text-cyan-glow">we can back up.</span>
        </h2>
        <p class="text-white/60 mt-5 max-w-xl leading-relaxed">
          Here’s the stack.
        </p>
      </div>

      <!-- Search bar (links to /library) -->
      <form
        action="/library"
        method="get"
        class="reveal w-full lg:w-[360px] shrink-0"
        style="transition-delay:0.1s"
      >
        <div
          class="flex items-center border border-white/15 bg-ink-800 focus-within:border-cyan transition-colors"
        >
          <span class="pl-4 text-white/30 font-mono text-sm">⌕</span>
          <input
            type="text"
            name="q"
            placeholder="Search the library…"
            class="flex-1 bg-transparent px-3 py-4 text-sm text-white placeholder:text-white/30 outline-none font-mono tracking-wide"
          />
          <button type="submit" class="btn btn-primary !py-4 !px-5">Go</button>
        </div>
      </form>
    </div>

    <!-- items-start lets each card size to its own content; the small
         per-card top offset breaks the ruler-straight grid edge -->
    <div class="grid md:grid-cols-3 gap-5 items-start">
      {
        featured.map((p, i) => (
          <a
            href={`/library/${p.slug}`}
            class={`edge-card reveal p-7 flex flex-col group ${['', 'md:mt-12', 'md:mt-5'][i] || ''}`}
            style={`transition-delay:${0.08 * i}s`}
          >
            <div class="flex items-start justify-between gap-3 mb-4">
              <span class="font-mono text-cyan text-sm">{p.year}</span>
              <span class="mono-label text-white/30 !text-[0.58rem] text-right">
                Added by {p.addedBy}
              </span>
            </div>
            <h3 class="headline text-2xl text-white mb-1 group-hover:text-cyan transition-colors">
              {p.title}
            </h3>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-white/40 mb-4">
              {p.authors}
            </p>
            <p class="text-white/70 text-[0.95rem] leading-relaxed mb-6">{p.summary}</p>
            <div class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="mono-label text-cyan/80 border border-cyan/25 px-2.5 py-1 !text-[0.58rem]">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 reveal">
      <a href="/library" class="btn btn-ghost">Browse all {paperCount} papers →</a>
    </div>
  </div>
</section>
