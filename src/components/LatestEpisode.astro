---
import EpisodeCard from './EpisodeCard.astro';
import { episodes } from '../data/episodes.js';

const latest = episodes[0];
---

<section class="section" id="latest">
  <div class="container-x">
    <div class="flex items-end justify-between gap-6 mb-10 reveal">
      <p class="eyebrow">Latest episode</p>
      <a href="/episodes" class="btn btn-ghost shrink-0 hidden md:inline-flex">All episodes →</a>
    </div>
    <div class="reveal">
      <EpisodeCard episode={latest} nowPlaying={true} />
    </div>
  </div>
</section>
