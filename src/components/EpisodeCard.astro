---
// Reusable episode card — the homepage "Latest Episode" treatment.
// The image and title link to the episode's own page; platform links and the
// timestamp highlight are their own links (no nested anchors).
const { episode, nowPlaying = false, showHighlight = true } = Astro.props;
const href = `/episodes/${episode.slug}`;
const hl = episode.highlight;
const showHl = showHighlight && hl;
---

<article class="edge-card grid lg:grid-cols-[1.15fr_1fr]">
  <!-- Visual -->
  <div class="relative min-h-[280px] lg:min-h-[480px] overflow-hidden group">
    <a href={href} class="block absolute inset-0">
      <img
        src={episode.image}
        alt={episode.title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-105"
      />
      <div
        class="absolute inset-0"
        style="background:linear-gradient(120deg, rgba(8,8,8,0.15) 0%, rgba(8,8,8,0.7) 100%)"
      >
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="w-20 h-20 flex items-center justify-center border border-cyan/70 text-cyan text-2xl backdrop-blur-sm bg-ink-900/30 transition-all duration-300 group-hover:bg-cyan group-hover:text-ink-900"
          style="box-shadow:0 0 40px rgba(0, 212, 212,0.25)"
        >
          ▶
        </span>
      </div>
    </a>
    {nowPlaying && <span class="absolute top-5 left-5 mono-label text-cyan">Now Playing</span>}
  </div>

  <!-- Body -->
  <div class="p-8 lg:p-12 flex flex-col">
    <div class="flex items-center gap-4 mb-5">
      <span class="font-mono text-5xl text-cyan leading-none">{episode.number}</span>
      <div class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-white/40 leading-relaxed">
        Episode<br />{episode.date}
      </div>
    </div>

    <a href={href}>
      <h3 class="headline text-4xl md:text-5xl text-white mb-4 hover:text-cyan transition-colors">
        {episode.title}
      </h3>
    </a>

    <p class="text-white/65 leading-relaxed mb-6 max-w-prose2">{episode.description}</p>

    {
      showHl && (
        <div class="border-l-2 border-cyan pl-5 mb-8 mt-auto">
          <a href={episode.youtubeUrl} class="group block">
            <div class="flex items-center gap-2 mb-2">
              <span class="font-mono text-cyan text-sm">{hl.time}</span>
              <span class="mono-label text-white/30 !text-[0.6rem] group-hover:text-cyan transition-colors">
                ▸ Jump to this moment
              </span>
            </div>
            <p class="text-white/85 italic leading-snug text-[1.05rem]">“{hl.quote}”</p>
            <p class="mono-label text-white/35 !text-[0.62rem] mt-2 !tracking-[0.12em]">
              {hl.context}
            </p>
          </a>
        </div>
      )
    }

    <div class={`flex flex-wrap gap-3 ${showHl ? '' : 'mt-auto'}`}>
      <a href={episode.youtubeUrl} class="btn btn-primary !py-3 !px-5">▸ YouTube</a>
      <a href={episode.spotifyUrl} class="btn btn-ghost !py-3 !px-5">Spotify</a>
      <a href={episode.appleUrl} class="btn btn-ghost !py-3 !px-5">Apple</a>
    </div>
  </div>
</article>
