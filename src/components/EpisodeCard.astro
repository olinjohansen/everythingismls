---
// Episode card — one row in the front-page list.
// The whole card is a single link to the episode page, where the video, the
// platform links and the show notes live together. Nothing plays from here,
// so there's no play button and no platform links to pull people off-site.
import { episodeHref, episodeImage } from '../data/episode-helpers.js';

const { episode, latest = false } = Astro.props;
const href = episodeHref(episode);
const image = episodeImage(episode);
---

<a href={href} class="episode-card edge-card grid lg:grid-cols-[1.15fr_1fr] group">
  <!-- Visual. The thumbnail keeps its native 16:9 inside a vertically-centred
       box — a YouTube title card cropped to fill a tall panel loses its text. -->
  <div class="relative flex items-center overflow-hidden">
    <div class="relative w-full aspect-video overflow-hidden">
      <img
        src={image}
        alt=""
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-105"
      />
    </div>
    {latest && <span class="absolute top-5 left-5 z-10 mono-label text-cyan">Latest</span>}
  </div>

  <!-- Body -->
  <div class="p-8 lg:p-12 flex flex-col">
    <div class="flex items-center gap-4 mb-5">
      <span class="font-mono text-5xl text-cyan leading-none">{episode.number}</span>
      <div
        class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-white/40 leading-relaxed"
      >
        Episode<br />{episode.date}{episode.duration && <> · {episode.duration}</>}
      </div>
    </div>

    <!-- Episode titles run long; sized so the body column stays near the
         height of the 16:9 thumbnail beside it -->
    <h3
      class="headline text-2xl md:text-3xl text-white mb-4 transition-colors group-hover:text-cyan"
    >
      {episode.title}
    </h3>

    {episode.guest && <p class="mono-label text-cyan mb-4">With {episode.guest}</p>}

    <p class="text-white/65 leading-relaxed mb-8 max-w-prose2">{episode.description}</p>

    <!-- Affordance only — the card itself is the link -->
    <span
      class="mt-auto font-mono uppercase tracking-[0.18em] text-[0.72rem] text-white/50 transition-colors group-hover:text-cyan"
    >
      Episode page <span class="card-arrow inline-block transition-transform">→</span>
    </span>
  </div>
</a>

<style>
  /* Keyboard focus needs to be visible now that the whole card is one target */
  .episode-card:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  .episode-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
